FROM node:20-slim

WORKDIR /app

# yt-dlp (usato per la riproduzione musicale) richiede il comando "python"; su Debian esiste solo
# "python3", quindi creiamo il link altrimenti lo script di installazione di yt-dlp-exec fallisce.
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates \
  && ln -s /usr/bin/python3 /usr/bin/python \
  && rm -rf /var/lib/apt/lists/*

COPY . .

RUN npm ci
RUN npm run db:generate
RUN npm run build -w packages/db
RUN npm run build -w apps/bot

CMD ["npm", "run", "start", "-w", "apps/bot"]
