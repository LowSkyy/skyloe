# Developer Portal → Bot → Reset Token
DISCORD_TOKEN=

# Developer Portal → General Information → Application ID
DISCORD_CLIENT_ID=

# ID del server Discord dove testare: fa registrare i comandi lì istantaneamente
# invece di aspettare fino a un'ora per la registrazione globale. Lascia vuoto
# per registrare i comandi globalmente (produzione).
DISCORD_GUILD_ID=

# Stessa stringa di connessione usata in packages/db/.env
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
