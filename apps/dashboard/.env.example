# Stessa stringa di connessione usata in packages/db/.env
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth — genera con: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Developer Portal → OAuth2 → Client ID / Client Secret (stessa app del bot)
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Stesso token del bot in apps/bot/.env — usato per leggere ruoli/canali del server nella dashboard
DISCORD_TOKEN=""
