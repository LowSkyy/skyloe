# Neon Postgres (https://neon.tech, piano gratuito) — connessione pooled, usata a runtime
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Neon Postgres — connessione diretta (non pooled), usata da Prisma Migrate
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
